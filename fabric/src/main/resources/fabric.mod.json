{
    "schemaVersion": 1,
    "id": "bearminimum",
    "version": "${version}",
  
    "name": "Bear Minimum",
    "description": "A minimal mod that adds more bear varieties and rebalances polar bears.",
    "authors": [
      "Startraveler"
    ],
  
    "license": "Apache 2.0",
    "icon": "assets/bearminimum/icon.png",
  
    "environment": "*",
    "entrypoints": {
      "main": [
        "com.startraveler.bearminimum.BearMinimum"
      ],
      "client": [
        "com.startraveler.bearminimum.BearMinimumClient"
      ]
    },
    "mixins": [
      "bearminimum.mixins.json"
    ],
  
    "depends": {
      "fabricloader": ">=0.14.25",
      "fabric": "*",
      "minecraft": "1.19.x",
      "java": ">=17"
    },
    "suggests": {
      "another-mod": "*"
    }
  }
  